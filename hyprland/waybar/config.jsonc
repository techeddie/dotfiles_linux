{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/ip",
        "clock",
        "tray"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "temperature",
        "network#wifi",
        "network#lan",
        "backlight",
        "pulseaudio",
        "battery"
    ],

    // ── Left ──────────────────────────────────────────────────────────────

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false
    },

    "hyprland/window": {
        "format": "\uf2d0  {title}",
        "max-length": 60,
        "separate-outputs": true
    },

    // ── Center ────────────────────────────────────────────────────────────

    "clock": {
        "interval": 1,
        "format": "\uf017  {:%H:%M   %d.%m.%Y}",
        "format-alt": "\uf073  {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    // ── Right ─────────────────────────────────────────────────────────────

    "cpu": {
        "interval": 1,
        "format": "\uf4bc  {usage:3}%",
        "tooltip": false
    },

    "memory": {
        "interval": 1,
        "format": "\uf538  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },

    "disk": {
        "interval": 30,
        "format": "\udb80\udc98  {free}",
        "path": "/",
        "tooltip-format": "{used} / {total} used on {path}"
    },

    "temperature": {
        "interval": 2,
        "hwmon-path": "/sys/devices/pci0000:00/0000:00:01.3/0000:01:00.0/hwmon/hwmon0/temp1_input",
        "critical-threshold": 65,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "{icon} {temperatureC}°C",
        "format-icons": ["\uf2cb", "\uf2ca", "\uf2c9", "\uf2c8", "\uf2c7", "\uf2c7"]
    },

    "network#wifi": {
        "interval": 1,
        "interface": "wlp0s20f3",
        "format-wifi": "\uf1eb  {essid}",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n\uf063  {bandwidthDownBytes}   \uf062  {bandwidthUpBytes}",
        "on-click": "networkmanager_dmenu"
    },

    "network#lan": {
        "interval": 1,
        "interface": "enp0s31f6",
        "format-wifi": "",
        "format-ethernet": "\uf6ff  {ifname} {ipaddr}",
        "format-disconnected": "",
        "tooltip-format-ethernet": "{ifname}\n\uf063  {bandwidthDownBytes}   \uf062  {bandwidthUpBytes}",
        "on-click": "networkmanager_dmenu"
    },
    // "networklan": {
    //     "interval": 1,
    //     "interface": "enp0s31f6",
    //     "format-wifi": "\uf1eb  {essid}",
    //     "format-ethernet": "\uf6ff  {ifname}",
    //     "format-disconnected": "\uf127  Offline",
    //     "tooltip-format-wifi": "{essid} ({signalStrength}%)\n\uf063  {bandwidthDownBytes}   \uf062  {bandwidthUpBytes}",
    //     "tooltip-format-ethernet": "{ifname}\n\uf063  {bandwidthDownBytes}   \uf062  {bandwidthUpBytes}",
    //     "on-click": "networkmanager_dmenu"
    // },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["\uf5dc", "\uf5dd", "\uf5de", "\uf5df", "\uf5e0"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9  Muted",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\uf590",
            "headset": "\uf590",
            "phone": "\uf095",
            "portable": "\uf095",
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "{desc} — {volume}%"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ACAD",
        "interval": 2,
        "full-at": 99,
        "states": {
            "warning": 30,
            "critical": 18
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7  {capacity}%",
        "format-not-charging": "\uf240  {capacity}%",
        "format-full": "\uf240  Full",
        "format-icons": ["\uf244", "\uf243", "\uf243", "\uf242", "\uf242", "\uf241", "\uf241", "\uf240", "\uf240", "\uf240"],
        "tooltip-format": "{timeTo} — {capacity}%"
    },

    "custom/ip": {
        "interval": 10,
        "exec": "curl -s https://api.ipify.org",
        "format": "\uf484  {}",
        "tooltip": false
    }

    // "keyboard-state": {
    //     "capslock": true,
    //     "format": {
    //         "capslock": "\uf11c  CAPS"
    //     },
    //     "format-icons": {
    //         "locked": "\uf023",
    //         "unlocked": "\uf09c"
    //     }
    // }
}

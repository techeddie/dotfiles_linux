# ---------------SWAY CONFIG EDDIE---------------------

#windows key
    set $mod Mod4
#alt key
    set $alt Mod1
#vars
    set $term kitty
    set $down k
    set $left j
    set $right h
    set $up l

    set $workspace1 "1"
    set $workspace2 "2"
    set $workspace3 "3"
    set $workspace4 "4"
    set $workspace5 "5"
    set $workspace6 "6"
    set $workspace7 "7"
    set $workspace8 "8"
    set $workspace9 "9"
    set $workspace10 "10"

    set $firstMonitor eDP-1
    set $secondMonitor HDMI-A-2


#-------------------------------------------------
# external inputs
  include ~/.config/sway/input.conf

  # hdmi left, notebook right
    output $secondMonitor position 0,0
    output $firstMonitor position 2560,0

  # wallpaper
    # output $secondMonitor bg ~/Pictures/WALLPAPER_FS01/HYPRLAND/car-with-full-moon-background.jpg fill
    # output $firstMonitor  bg ~/Pictures/WALLPAPER_FS01/HYPRLAND/shaded_landscape.png fill

    exec awww-daemon
    exec_always awww img ~/Pictures/WALLPAPER_FS01/HYPRLAND/car-with-full-moon-background.jpg --outputs $secondMonitor
    exec_always awww img ~/Pictures/WALLPAPER_FS01/HYPRLAND/shaded_landscape.png --outputs $firstMonitor

#-------------------------------------------------
#lockscreen
    # manual lock via super+l
    bindsym $mod+l exec swaylock

#workspace
    workspace_layout default

    #define monitor output
    workspace 1 output $secondMonitor
    workspace 2 output $secondMonitor
    workspace 3 output $secondMonitor
    workspace 4 output $secondMonitor
    workspace 6 output $secondMonitor
    workspace 7 output $secondMonitor
    workspace 8 output $secondMonitor
    workspace 9 output $secondMonitor
    workspace 10 output $firstMonitor

    #switch workspace
    bindsym $alt+Ctrl+j       workspace prev
    bindsym $alt+Ctrl+k       workspace next
    bindsym $alt+Tab          workspace back_and_forth
    bindsym $mod+Next         workspace next
    bindsym $mod+Prior        workspace prev
    bindsym $mod+Shift+End    workspace next
    bindsym $mod+Shift+Home   workspace prev
    bindsym $mod+Shift+j      workspace prev
    bindsym $mod+Shift+k      workspace next

    #switch to workspace
    bindsym $mod+0              workspace $workspace10
    bindsym $mod+1              workspace $workspace1
    bindsym $mod+2              workspace $workspace2
    bindsym $mod+3              workspace $workspace3
    bindsym $mod+4              workspace $workspace4
    bindsym $mod+5              workspace $workspace5
    bindsym $mod+6              workspace $workspace6
    bindsym $mod+7              workspace $workspace7
    bindsym $mod+8              workspace $workspace8
    bindsym $mod+9              workspace $workspace9
    bindsym $mod+Shift+Return   workspace $workspace1

    # move focused container to workspace
    bindsym $mod+Shift+0 move container to workspace 10; workspace 10
    bindsym $mod+Shift+1 move container to workspace 1; workspace 1
    bindsym $mod+Shift+2 move container to workspace 2; workspace 2
    bindsym $mod+Shift+3 move container to workspace 3; workspace 3
    bindsym $mod+Shift+4 move container to workspace 4; workspace 4
    bindsym $mod+Shift+5 move container to workspace 5; workspace 5
    bindsym $mod+Shift+6 move container to workspace 6; workspace 6
    bindsym $mod+Shift+7 move container to workspace 7; workspace 7
    bindsym $mod+Shift+8 move container to workspace 8; workspace 8
    bindsym $mod+Shift+9 move container to workspace 9; workspace 9

#-------------------------------------------------
#gaps
    gaps inner 10
    gaps outer 10

    workspace 1 gaps inner 10
    workspace 2 gaps outer 10
    workspace 3 gaps inner 10
    workspace 4 gaps inner 10
    workspace 5 gaps inner 10
    workspace 6 gaps inner 10
    workspace 7 gaps inner 10
    workspace 8 gaps outer 10
    workspace 9 gaps outer 10
    workspace 0 gaps outer 10

    bindsym $mod+F1 gaps inner current set 0; gaps outer current set 0
    bindsym $mod+F2 gaps inner current set 10; gaps outer current set 10
    bindsym $mod+F3 gaps inner current set 35; gaps outer current set 10
    bindsym $mod+F4 gaps inner current set 70; gaps outer current set 10

    #scratchpad
    bindsym $mod+z move scratchpad
    bindsym $mod+y move scratchpad
    bindsym $mod+u scratchpad show; move position center

    #scratchpad move
    for_window [title="^(?!.*(Open|Select|Save|Import|Export)).*KeePassXC$"] floating enable, resize set 900 600, move scratchpad
    for_window [app_id="floating-term"] floating enable, resize set 1400 500, move scratchpad
    for_window [app_id="org.gnome.DiskUtility"] floating enable, resize set 800 600, move scratchpad
    for_window [app_id="sublime_text" title="^(?!.*(New File|Open File)).*UNREGISTERED.*$"] floating enable, resize set 1400 900, move scratchpad, move position center

    #scratchpad toggle maps
    bindsym $mod+Delete      [app_id="sublime_text"] scratchpad show, move position center
    bindsym $mod+Shift+g     [app_id="org.gnome.DiskUtility"] scratchpad show, move position center
    bindsym $mod+a           [title=".*KeePassXC$"] scratchpad show, move position center
    bindsym $mod+g           [title=".*Sublime Text.*"] scratchpad show, move position center
    bindsym $mod+grave       [title=".*KeePassXC$"] scratchpad show, move position center
    bindsym F12              [app_id="floating-term"] scratchpad show, move position center

#-------------------------------------------------
#key bindings to launch applications

    # bindsym $mod+F5                 exec sh ~/scripts/runHDMI_ONLY.sh
    # bindsym $mod+F6                 exec sh ~/scripts/runHDMI_OFF.sh
    # bindsym $mod+F7                 exec sh ~/scripts/runHDMI_AND_NOTEBOOK.sh
    # bindsym $mod+space            exec swaymsg input type:keyboard xkb_switch_layout next
    bindsym $alt+Shift+p            exec bash -c 'pkill waybar; pkill swaync; sleep 0.3; waybar & swaync &'
    bindsym $mod+$alt+Ctrl+f        exec fsearch
    bindsym $mod+$alt+ctrl+c        exec swaymsg -q '[app_id=chromium] focus' 2>/dev/null || chromium
    bindsym $mod+$alt+ctrl+m        exec swaymsg -q '[app_id=mpv] focus' 2>/dev/null || mpv --player-operation-mode=pseudo-gui
    bindsym $mod+$alt+ctrl+t        exec swaymsg -q '[app_id=org.telegram.desktop] focus' 2>/dev/null || telegram-desktop
    bindsym $mod+F10                exec sh ~/config/rdp/HZ-DC01
    bindsym $mod+F11                exec sh ~/config/rdp/HZ-EX02.sh
    bindsym $mod+F12                exec sh ~/config/rdp/HZ-APP02.sh
    bindsym $mod+F5               exec swaymsg output HDMI-A-1 enable, output eDP-1 disable
    bindsym $mod+F6               exec swaymsg output HDMI-A-1 disable
    bindsym $mod+F7               exec swaymsg output HDMI-A-1 enable, output eDP-1 enable
    bindsym $mod+F8                 exec sh ~/scripts/restic/restic_runBackupS3.sh
    bindsym $mod+F9                 exec sh ~/scripts/restic/restic_ALL.sh
    bindsym $mod+Return             exec $term
    bindsym $mod+Shift+F11          exec $term --class sp-backup.root -e doas bash /home/eddie/scripts/btrfs/root/backup.root.sh
    bindsym $mod+Shift+F12          exec $term --class sp-backup.home -e doas bash /home/eddie/scripts/btrfs/home/backup.home_auto.sh
    bindsym $mod+Shift+b            exec blueman-manager
    bindsym $mod+Shift+c            exec swaymsg -q '[app_id=chromium] focus' 2>/dev/null || chromium
    bindsym $mod+Shift+f            exec swaymsg -q '[app_id=floorp] focus' 2>/dev/null || floorp
    bindsym $mod+Shift+l            exec kitty -e lf ~/
    bindsym $mod+Shift+p            exec kitty -e pacseek
    bindsym $mod+Shift+u            exec sh ~/scripts/runRemoveUSB.sh
    bindsym $mod+Shift+v            exec swaymsg -q '[app_id=vlc] focus' 2>/dev/null || vlc
    bindsym $mod+Shift+w            exec networkmanager_dmenu
    bindsym $mod+Shift+z            exec sh ~/scripts/runTogglePowerMode.sh
    bindsym $mod+b                  exec swaymsg -q '[app_id=brave-browser] focus' 2>/dev/null || brave
    bindsym $mod+c                  exec swaymsg -q '[app_id=chromium] focus' 2>/dev/null || chromium
    bindsym $mod+d                  exec swaymsg -q '[app_id=doublecmd] focus' 2>/dev/null || doublecmd
    bindsym $mod+e                  exec thunar
    bindsym $mod+n                  exec swaymsg -q '[app_id=obsidian] focus' 2>/dev/null || obsidian
    bindsym $mod+o                  exec swaymsg -q '[app_id=org.mozilla.thunderbird_es] focus' 2>/dev/null || org.mozilla.thunderbird_es
    bindsym $mod+shift+i            exec swayprop
    bindsym $mod+space              exec sh ~/scripts/runToggleKeyboardLayout.sh
    bindsym control+$alt+m          exec pavucontrol
    bindsym control+Shift+Escape    exec /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=resources net.nokyan.Resources

    # CPU performance profiles
    bindsym $mod+Shift+F1 exec "sudo cpupower frequency-set -u 800MHz && notify-send 'CPU' 'Powersave (800MHz)'"
    bindsym $mod+Shift+F2 exec "sudo auto-cpufreq --force=reset && sudo cpupower frequency-set -u 800MHz && notify-send 'CPU' 'Auto'"
    bindsym $mod+Shift+F3 exec "sudo cpupower frequency-set -u 2300MHz && notify-send 'CPU' 'Balanced (2300MHz)'"
    bindsym $mod+Shift+F4 exec "sudo cpupower frequency-set -u 4600MHz && notify-send 'CPU' 'Performance (4600MHz)'"

    # CHANGE: screenshots — maim/xclip → grim/slurp/wl-copy
    # Install: sudo pacman -S grim slurp wl-clipboard
    # selection → clipboard
    bindsym Print exec bash -c 'grim -g "$(slurp)" - | wl-copy'
    # selection → file + clipboard
    bindsym $mod+Print exec bash -c 'grim -g "$(slurp)" - | tee ~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png | wl-copy'
    # fullscreen → file + clipboard
    bindsym $mod+Shift+Print exec bash -c 'grim - | tee ~/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png | wl-copy'

    #rofi theme
      set $rofi_theme ~/gitREPO/dotfiles_linux/rofi/themes/sway-arch-dark.rasi

    #rofi maps
      bindsym $mod+w              exec rofi -combi-modi window -show combi -show-icons -theme $rofi_theme
      bindsym $mod+m              exec rofi -combi-modi window -show drun -show-icons -theme $rofi_theme
      bindsym $mod+Shift+m        exec sh ~/gitREPO/dotfiles_linux/i3/scripts/rofi.pkill.sh
      bindsym F1 exec bash -c '\
          selected=$(cliphist list | awk "!seen[\$0]++" | rofi -dmenu -theme '"$rofi_theme"'); \
          if [ -n "$selected" ]; then \
              echo "$selected" | cliphist decode | wl-copy; \
              sleep 0.2; \
              wtype -M ctrl -P v -p v -m ctrl; \
          fi'
      bindsym Shift+F1 exec bash -c 'cliphist list | rofi -dmenu -theme '"$rofi_theme"' | cliphist delete'
      bindsym $mod+j exec bash -c 'cliphist list | awk '"'"'!seen[$0]++'"'"' | rofi -dmenu -theme '"$rofi_theme"' | cliphist decode | wl-copy && sleep 0.1 && wtype -M shift -P Insert -p Insert -m shift'

#-------------------------------------------------
#execute on logon - AUTOSTARTUP

    # exec brave
    # exec obsidian
    exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    exec /usr/lib/xfce4/notifyd/xfce4-notifyd
    exec blueman-applet
    exec gnome-disks
    exec keepassxc
    exec kitty --class floating-term -e tmux new-session -A -s scratchpad
    exec nm-applet
    exec seafile-applet
    exec sh -c 'kitty -e sh -c "tmux" & sleep 0.5 && swaymsg "move container to workspace 1; workspace 1"'
    exec subl
    exec swaync
    exec waybar
    exec wl-paste --watch cliphist store
    exec_always autotiling

#-------------------------------------------------
# windows settings and behaviour

    # CHANGE: title_window_icon not supported in Sway — removed
    # for_window [all] title_window_icon padding 3px

    title_align right
    popup_during_fullscreen smart
    # default_border normal 5
    focus_follows_mouse yes
    show_marks yes

    bindsym $mod+f  fullscreen toggle
    # CHANGE: i3-msg → swaymsg
    bindsym $mod+$alt+b exec swaymsg border toggle
    bindsym $alt+Shift+b exec swaymsg border toggle

    # CHANGE: floating_modifier needs 'normal' in Sway for move+resize behavior
    floating_modifier $mod normal

    bindsym $mod+h split v
    bindsym $mod+v split h

    #kill current windows
    bindsym $mod+q              [con_id="__focused__" instance="^(?!dropdown_).*$"] kill
    bindsym $mod+k              [con_id="__focused__" instance="^(?!dropdown_).*$"] kill
    # CHANGE: xkill removed (X11 only) — use swaymsg kill instead
    bindsym --release $mod+Escape exec swaymsg kill

    # CHANGE: xautolock/betterlockscreen removed — swayidle handles this (see bottom of config)

    #suspend
    # bindsym $mod+Shift+s exec swaylock -f && systemctl suspend
    bindsym $mod+Shift+s exec bash -c 'swaylock & sleep 3; systemctl suspend'

    #logoff shutdown reboot menu
    # bindsym $mod+x exec wlogout
    bindsym $mod+x exec wlogout -b 2 -c 2 -r 0 -m 2  --margin-top 400 --margin-bottom 400 --margin-left 600 --margin-right 600
    bindsym $mod+Shift+x exec systemctl poweroff

    # reload config
    bindsym $mod+Shift+r     exec notify-send -t 2500 -i "preferences-system" "Sway" "config reloaded" && swaymsg reload
    bindsym $mod+r           exec notify-send -t 2500 -i "preferences-system" "Sway" "config reloaded" && swaymsg reload

    default_orientation horizontal

    # focus windows
    bindsym $mod+Left focus left
    bindsym $mod+Right focus right
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up

    bindsym $mod+s layout stacking
    bindsym $mod+Shift+t layout tabbed

    ################# resize
    bindsym $mod+$alt+Left resize shrink width 6 px or 6 ppt
    bindsym $mod+$alt+Up resize grow height 6 px or 6 ppt
    bindsym $mod+$alt+Down resize shrink height 6 px or 6 ppt
    bindsym $mod+$alt+Right resize grow width 6 px or 6 ppt
    bindsym $mod+minus resize shrink width 6 px or 6 ppt
    bindsym $mod+equal resize grow width 6 px or 6 ppt
    bindsym $mod+Shift+minus resize shrink height 6 px or 6 ppt
    bindsym $mod+Shift+equal resize grow height 6 px or 6 ppt

    bindsym $mod+Shift+Left move left
    bindsym $mod+$alt+h move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+$alt+j move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+$alt+k move up
    bindsym $mod+Shift+Right move right
    bindsym $mod+$alt+l move right

    ################# FOR_WINDOW
    # border stuff, verify per app with:
    # swaymsg -t get_tree | grep -E 'app_id|class'

    # hide_edge_borders both
    for_window [app_id="^.*"] border pixel 2
    for_window [class="^.*"] border pixel 2

    for_window [app_id="brave-browser"] border pixel 2
    for_window [app_id="firefox"] border none, layout tabbed
    for_window [app_id="floorp"] border none, layout tabbed
    for_window [app_id="kitty"] border pixel 2
    for_window [app_id="md.obsidian.Obsidian"] border pixel 2
    for_window [app_id="org.gnome.DiskUtility"] floating enable, resize set 2300 900, move position center
    for_window [app_id="org.mozilla.thunderbird_esr"] border pixel 2
    for_window [app_id="Dunst"] border none
    for_window [app_id="Ledger Live"] border normal
    for_window [app_id="org.telegram.desktop"] border none
    for_window [app_id="Virt-manager"] border normal, layout tabbed
    for_window [app_id="Wfica"] border normal
    for_window [class="xfreerdp"] border normal
    no_focus   [class="Dunst"]

    # floating
    bindsym $mod+t floating toggle
    for_window [app_id="^(com\.seafile\.seafile-apple|lxappearance|org\.gnome\.Calculator|nm-connection-editor|pavucontrol|copyq)$"] floating enable, move position center
    for_window [class="^(Seafile Client|Grub-customizer|TimeShift-gtk|Woeusbgui|nextcloud)$"] floating enable, move position center
    for_window [title="^(Copying|Deleting|Moving|Preferences|Volume Control)$"] floating enable, move position center
    for_window [title="Rename|Writing"] floating enable, focus
    for_window [title="^(Packing|Receive Connector|Send Connector)$"] floating enable, move position center, border normal
    for_window [app_id="^sp-backup\.(root|home)$"] floating enable, resize set 1536 400, move position 170 px 680 px
    for_window [class="Io.github.cboxdoerfer.FSearch"] floating enable
    for_window [class="TeamViewer"] floating enable, resize set 800 900, move position center
    for_window [app_id="blueman-manager"] floating enable, resize set 900 600, move position center
    for_window [class="Doublecmd" title="Options"] floating enable, resize set 800 600, move position center
    for_window [class="Doublecmd" title="Edit"] floating enable, move position center
    for_window [title="Remmina Remote"] floating enable, resize set 400 500, move position center
    for_window [title="Bitwarden|Vaultwarden"] floating enable
    for_window [title="^popup$"] floating enable, move position center
    for_window [title="New Event|Edit Calendar|Write:"] floating enable, resize set 1536 800, move position center
    for_window [title="\[[0-9]+\]@T490"] floating enable, focus

    # focus
    focus_on_window_activation focus
    for_window [app_id="brave-browser"] focus
    for_window [app_id="org.gnome.DiskUtility"] focus
    for_window [app_id="brave-browser"] focus
    for_window [app_id="Doublecmd"] focus
    for_window [class="Gcr-prompter"] focus
    for_window [app_id="floorp"] focus
    for_window [instance="xfreerdp"] focus
    for_window [urgent=latest] focus

    # thunar copy progress
    for_window [title="Copying files to"] floating enable
    for_window [title="This folder already contains"] floating enable, focus

    # full screen
    for_window [app_id="mpv"] fullscreen enable

    # always launch app on workspace x
    assign [app_id="brave-browser" title="Files - Nextcloud"] $workspace10
    assign [app_id="brave-browser" title="Outlook"] $workspace10
    assign [app_id="brave-browser"] $workspace2
    assign [app_id="chromium"] $workspace5
    assign [app_id="firefox"] $workspace5
    assign [app_id="floorp"] $workspace5
    assign [app_id="md.obsidian.Obsidian"] $workspace3
    assign [app_id="org.mozilla.thunderbird_es"] $workspace6
    assign [app_id="xfreerdp"] $workspace8
    assign [app_id="Ledger Live"] $workspace6
    assign [app_id="Selfservice"] $workspace8
    assign [app_id="org.telegram.desktop"] $workspace4
    assign [app_id="Wfica"] $workspace8

#-------------------------------------------------
# audio controls (unchanged — pipewire/pulseaudio work the same)
    bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +2%
    bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -2%
    bindsym XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle
    bindsym XF86AudioPlay exec playerctl play-pause
    bindsym XF86AudioNext exec playerctl next
    bindsym XF86AudioPrev exec playerctl previous
    bindsym XF86AudioStop exec playerctl stop

#-------------------------------------------------
# CHANGE: brightness — xbacklight → brightnessctl
# Install: sudo pacman -S brightnessctl
    bindsym XF86MonBrightnessUp exec brightnessctl set +5%
    bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

#-------------------------------------------------
# window colors
    client.focused          #6790EB #6790EB #e5e5e5 #6790EB
    client.unfocused        #222222 #222222 #aaaaaa #222222
    client.focused_inactive #222222 #222222 #a9a9a9 #222222
    client.placeholder      #222222 #222222 #aaaaaa #222222
    client.urgent           #d42121 #d42121 #f7f7f7 #d42121
    client.background       #242424

#-------------------------------------------------
# Wayland environment
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Idle and lockscreen
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f'

# GTK dark theme
exec {
    gsettings set org.gnome.desktop.interface gtk-theme 'catppuccin-mocha-blue-standard+default'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus'
    gsettings set org.gnome.desktop.interface font-name 'Noto Sans 10'
    gsettings set org.gnome.desktop.interface cursor-theme 'Breeze_Light'
    gsettings set org.gnome.desktop.interface cursor-size 26
}

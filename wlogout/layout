{
    "label": "logout",
    "action": "swaymsg exit",
    "text": "Logout",
    "keybind": "l"
},
{
    "label": "suspend",
    "action": "swaylock -f && systemctl suspend",
    "text": "Suspend",
    "keybind": "s"
},
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
},
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "x"
}
